<?xml version="1.0" encoding="UTF-8"?>
<!-- Packaging adds a <releases> entry for the version being built. -->
<component type="desktop-application">
  <id>dev.sonata.musicplayer</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LGPL-3.0-only</project_license>
  <name>Sonata</name>
  <summary>Play and organize your local music library</summary>
  <developer id="io.github.zarzet">
    <name>zarzet</name>
  </developer>
  <description>
    <p>
      Sonata is an offline-first music player and library manager based on
      Mornye. It plays local music, edits metadata, and can fetch optional
      lyrics through configured providers.
    </p>
    <ul>
      <li>Lossless playback with an equalizer</li>
      <li>Library scanning, metadata editing and cover art</li>
      <li>Timed lyrics, translation and romanization when available</li>
    </ul>
  </description>
  <launchable type="desktop-id">dev.sonata.musicplayer.desktop</launchable>
  <provides>
    <binary>sonata</binary>
  </provides>
  <url type="homepage">https://github.com/mornyeapp/Mornye</url>
  <url type="bugtracker">https://github.com/mornyeapp/Mornye/issues</url>
  <url type="translate">https://crowdin.com/project/mornye</url>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
</component>
